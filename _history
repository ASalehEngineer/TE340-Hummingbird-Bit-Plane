"B\"><shadow type=\"math_number\"><field name=\"NUM\">30</field></shadow></value></block></value></block></value></block></statement></block></statement></block></xml>","main.ts":"","README.md":"","main.py":"\n# ==========================================\n# MICROBIT AIRCRAFT WARNING SYSTEM\n# Hummingbird + MICROBIT V2 SPEAKER\n# ==========================================\n\n# ==========================================\n# BANK ANGLE WARNING\n# ==========================================\n\ndef play_airbus_bank_angle():\n    # Airbus-style triple chime\n    notes = [740, 880, 740]\n\n    while bank_angle == 1:\n        for hz in notes:\n            if bank_angle != 1:\n                return\n\n            music.play(music.create_sound_expression(\n                WaveShape.TRIANGLE,\n                hz,\n                hz,\n                255,\n                180,\n                140,\n                SoundExpressionEffect.NONE,\n                InterpolationCurve.LINEAR),\n                music.PlaybackMode.UNTIL_DONE)\n\n            basic.pause(50)\n\n        basic.pause(400)\n\n\n# ==========================================\n# LOGO LONG PRESS - STROBES\n# ==========================================\n\ndef on_logo_long_pressed():\n    global stobes\n\n    if stobes == 0:\n        stobes = 1\n    else:\n        stobes = 0\n        hummingbird.set_tri_led(TwoPort.ONE, 0, 0, 0)\n        hummingbird.set_tri_led(TwoPort.TWO, 0, 0, 0)\n\ninput.on_logo_event(\n    TouchButtonEvent.LONG_PRESSED,\n    on_logo_long_pressed\n)\n\n\n# ==========================================\n# PULL UP WARNING\n# ==========================================\n\ndef play_airbus_pull_up():\n    # Repeating EGPWS-style rising WHOOP tones\n    # Followed by two lower warning pulses\n\n    while pull_up == 1:\n\n        for repeat in range(2):\n            if pull_up != 1:\n                return\n\n            music.play(music.create_sound_expression(\n                WaveShape.SINE,\n                500,\n                1400,\n                255,\n                255,\n                260,\n                SoundExpressionEffect.VIBRATO,\n                InterpolationCurve.CURVE),\n                music.PlaybackMode.UNTIL_DONE)\n\n            basic.pause(90)\n\n        if pull_up != 1:\n            return\n\n        music.play(music.create_sound_expression(\n            WaveShape.TRIANGLE,\n            620,\n            620,\n            255,\n            190,\n            150,\n            SoundExpressionEffect.NONE,\n            InterpolationCurve.LINEAR),\n            music.PlaybackMode.UNTIL_DONE)\n\n        basic.pause(100)\n\n        if pull_up != 1:\n            return\n\n        music.play(music.create_sound_expression(\n            WaveShape.TRIANGLE,\n            850,\n            850,\n            255,\n            190,\n            170,\n            SoundExpressionEffect.NONE,\n            InterpolationCurve.LINEAR),\n            music.PlaybackMode.UNTIL_DONE)\n\n        basic.pause(300)\n\n\n# ==========================================\n# IMPROVED AIRBUS STALL WARNING\n# ==========================================\n\ndef play_airbus_stall():\n    # Airbus-inspired cricket stall warning\n    # Fast high-frequency chirps\n    # Repeated until warning is cancelled\n\n    while stall == 1:\n\n        for burst in range(3):\n\n            for chirp in range(5):\n\n                if stall != 1:\n                    return\n\n                # High-frequency cricket chirp\n                music.play(music.create_sound_expression(\n                    WaveShape.SINE,\n                    3200,\n                    2600,\n                    255,\n                    200,\n                    45,\n                    SoundExpressionEffect.VIBRATO,\n                    InterpolationCurve.CURVE),\n                    music.PlaybackMode.UNTIL_DONE)\n\n                basic.pause(18)\n\n            basic.pause(45)\n\n        basic.pause(120)\n\n\n# ==========================================\n# A320 AUTOPILOT DISCONNECT\n# ==========================================\n\ndef play_airbus_autopilot_disengage():\n    # Airbus-inspired cavalry charge\n    # Alternating falling and rising tones\n    # Approximately 1.5 seconds per shake\n\n    for cycle in range(6):\n\n        if ap_off != 1:\n            return\n\n        # Falling tone\n        music.play(music.create_sound_expression(\n            WaveShape.SINE,\n            1200,\n            820,\n            255,\n            255,\n            100,\n            SoundExpressionEffect.NONE,\n            InterpolationCurve.CURVE),\n            music.PlaybackMode.UNTIL_DONE)\n\n        basic.pause(20)\n\n        if ap_off != 1:\n            return\n\n        # Rising tone\n        music.play(music.create_sound_expression(\n            WaveShape.SINE,\n            820,\n            1200,\n            255,\n            255,\n            100,\n            SoundExpressionEffect.NONE,\n            InterpolationCurve.CURVE),\n            music.PlaybackMode.UNTIL_DONE)\n\n        basic.pause(20)\n\n\n# ==========================================\n# BUTTON A - DISTANCE DISPLAY\n# ==========================================\n\ndef on_button_pressed_a():\n    global display\n\n    if display == 0:\n        display = 1\n    else:\n        display = 0\n\n        basic.show_leds(\"\"\"\n            . . # . .\n            . . # . .\n            # # # # #\n            . . # . .\n            . # # # .\n        \"\"\")\n\ninput.on_button_pressed(\n    Button.A,\n    on_button_pressed_a\n)\n\n\n# ==========================================\n# LOGO UP - STALL\n# ==========================================\n\ndef on_gesture_logo_up():\n    global stall, pull_up, bank_angle, ap_off\n\n    music.stop_all_sounds()\n\n    stall = 1\n    pull_up = 0\n    bank_angle = 0\n    ap_off = 0\n\n    play_airbus_stall()\n\ninput.on_gesture(\n    Gesture.LOGO_UP,\n    on_gesture_logo_up\n)\n\n\n# ==========================================\n# TILT LEFT - BANK ANGLE\n# ==========================================\n\ndef on_gesture_tilt_left():\n    global bank_angle, stall, pull_up, ap_off\n\n    music.stop_all_sounds()\n\n    bank_angle = 1\n    stall = 0\n    pull_up = 0\n    ap_off = 0\n\n    play_airbus_bank_angle()\n\ninput.on_gesture(\n    Gesture.TILT_LEFT,\n    on_gesture_tilt_left\n)\n\n\n# ==========================================\n# SHAKE - AUTOPILOT DISCONNECT\n# ==========================================\n\ndef on_gesture_shake():\n    global ap_off, bank_angle, stall, pull_up\n\n    music.stop_all_sounds()\n\n    ap_off = 1\n    bank_angle = 0\n    stall = 0\n    pull_up = 0\n\n    # Play immediately when shaken\n    play_airbus_autopilot_disengage()\n\ninput.on_gesture(\n    Gesture.SHAKE,\n    on_gesture_shake\n)\n\n\n# ==========================================\n# SCREEN UP - RESET WARNINGS\n# ==========================================\n\ndef on_gesture_screen_up():\n    global bank_angle, stall, pull_up, ap_off\n\n    bank_angle = 0\n    stall = 0\n    pull_up = 0\n    ap_off = 0\n\n    music.stop_all_sounds()\n\n    if display == 0:\n        basic.show_leds(\"\"\"\n            . . # . .\n            . . # . .\n            # # # # #\n            . . # . .\n            . # # # .\n        \"\"\")\n\ninput.on_gesture(\n    Gesture.SCREEN_UP,\n    on_gesture_screen_up\n)\n\n\n# ==========================================\n# BUTTON B - LANDING LIGHTS\n# ==========================================\n\ndef on_button_pressed_b():\n    global landing\n\n    if landing == 0:\n        landing = 1\n    else:\n        landing = 0\n\ninput.on_button_pressed(\n    Button.B,\n    on_button_pressed_b\n)\n\n\n# ==========================================\n# TILT RIGHT - BANK ANGLE\n# ==========================================\n\ndef on_gesture_tilt_right():\n    global bank_angle, stall, pull_up, ap_off\n\n    music.stop_all_sounds()\n\n    bank_angle = 1\n    stall = 0\n    pull_up = 0\n    ap_off = 0\n\n    play_airbus_bank_angle()\n\ninput.on_gesture(\n    Gesture.TILT_RIGHT,\n    on_gesture_tilt_right\n)\n\n\n# ==========================================\n# LOGO DOWN - PULL UP\n# ==========================================\n\ndef on_gesture_logo_down():\n    global pull_up, stall, bank_angle, ap_off\n\n    music.stop_all_sounds()\n\n    pull_up = 1\n    stall = 0\n    bank_angle = 0\n    ap_off = 0\n\n    play_airbus_pull_up()\n\ninput.on_gesture(\n    Gesture.LOGO_DOWN,\n    on_gesture_logo_down\n)\n\n\n# ==========================================\n# LOGO PRESS - NAVIGATION LIGHTS\n# ==========================================\n\ndef on_logo_pressed():\n    global nav\n\n    if nav == 0:\n        nav = 1\n    else:\n        nav = 0\n\ninput.on_logo_event(\n    TouchButtonEvent.PRESSED,\n    on_logo_pressed\n)\n\n\n# ==========================================\n# INITIALIZATION\n# ==========================================\n\ndisplay = 0\nnav = 0\nstobes = 0\nlanding = 0\n\nbank_angle = 0\nstall = 0\npull_up = 0\nap_off = 0\n\nhummingbird.start_hummingbird()\n\nmusic.set_volume(255)\nbasic.clear_screen()\n\nbasic.show_leds(\"\"\"\n    . . # . .\n    . . # . .\n    # # # # #\n    . . # . .\n    . # # # .\n\"\"\")\n\n\n# ==========================================\n# NAVIGATION AND LANDING LIGHTS\n# ==========================================\n\ndef on_every_interval2():\n\n    if nav == 0:\n        hummingbird.set_led(ThreePort.ONE, 0)\n        hummingbird.set_led(ThreePort.TWO, 0)\n    else:\n        hummingbird.set_led(ThreePort.ONE, 100)\n        hummingbird.set_led(ThreePort.TWO, 100)\n\n    if landing == 0:\n        hummingbird.set_led(ThreePort.THREE, 0)\n    else:\n        hummingbird.set_led(ThreePort.THREE, 100)\n\nloops.every_interval(100, on_every_interval2)\n\n\n# ==========================================\n# DISTANCE DISPLAY\n# ==========================================\n\ndef on_every_interval3():\n\n    if (stall == 0 and\n        pull_up == 0 and\n        bank_angle == 0 and\n        ap_off == 0 and\n        display == 1):\n\n        distance = Math.round(\n            hummingbird.get_sensor(\n                SensorType.DISTANCE,\n                ThreePort.THREE\n            ) / 30\n        )\n\n        dial = hummingbird.get_sensor(\n            SensorType.DIAL,\n            ThreePort.ONE\n        )\n\n        if distance > 8 and dial == 0:\n            basic.show_number(0)\n        else:\n            basic.show_number(distance)\n\nloops.every_interval(100, on_every_interval3)\n\n\n# ==========================================\n# ANTI-COLLISION STROBES\n# ==========================================\n\ndef on_every_interval4():\n\n    if stobes == 1:\n\n        hummingbird.set_tri_led(\n            TwoPort.ONE, 100, 100, 100\n        )\n\n        hummingbird.set_tri_led(\n            TwoPort.TWO, 100, 100, 100\n        )\n\n        basic.pause(50)\n\n        if stobes != 1:\n            return\n\n        hummingbird.set_tri_led(\n            TwoPort.ONE, 0, 0, 0\n        )\n\n        hummingbird.set_tri_led(\n            TwoPort.TWO, 0, 0, 0\n        )\n\n        basic.pause(100)\n\n        if stobes != 1:\n            return\n\n        hummingbird.set_tri_led(\n            TwoPort.ONE, 100, 100, 100\n        )\n\n        hummingbird.set_tri_led(\n            TwoPort.TWO, 100, 100, 100\n        )\n\n        basic.pause(50)\n\n        hummingbird.set_tri_led(\n            TwoPort.ONE, 0, 0, 0\n        )\n\n        hummingbird.set_tri_led(\n            TwoPort.TWO, 0, 0, 0\n        )\n\nloops.every_interval(1250, on_every_interval4)\n\n\n# ==========================================\n# WARNING DISPLAY\n# ==========================================\n\ndef on_every_interval5():\n\n    if stall == 1:\n        basic.show_string(\"Stall\")\n\n    elif pull_up == 1:\n        basic.show_string(\"Pull\")\n\n    elif bank_angle == 1:\n        basic.show_string(\"Bank\")\n\n    elif ap_off == 1:\n        basic.show_string(\"AP\")\n\nloops.every_interval(750, on_every_interval5)\n","pxt.json":"{\n    \"name\": \"TE340 Hummingbird Plane\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"pxt-hummingbird-bit\": \"github:birdbraintechnologies/pxt-hummingbird-bit#v0.0.7\",\n        \"microphone\": \"*\",\n        \"audio-recording\": \"*\",\n        \"pxt-flexfx\": \"github:grandpabond/pxt-flexfx#v2.2.7\",\n        \"midi\": \"github:microsoft/pxt-midi#v2.2.0\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"targetVersions\": {\n        \"branch\": \"v1.2.13\",\n        \"tag\": \"v1.2.13\",\n        \"commits\": \"https://github.com/Microsoft/pxt-microbit/commits/5d5b348757b15c6d00f5b7f560fd69592ca29424\",\n        \"target\": \"9.0.12\",\n        \"pxt\": \"4.4.7\"\n    },\n    \"preferredEditor\": \"pyprj\"\n}\n"}},{"timestamp":1795497167568,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"Lf^QP9~DZv]?v31TVIrX\">stall</variable><variable id=\"@+3X)tw,b;KC7@;?pzuu\">bank_angle</variable><variable id=\"F`4Gp[+fCPwlIy3q]RQ3\">display</variable><variable id=\"XSLg=N3X@@a0kC*?oX)C\">stobes</variable><variable id=\"44hBWFa!]8}sBAW]hg+g\">nav</variable><variable id=\"@|ECe@}Ev]{VAxEEnZD1\">landing</variable><variable id=\"BfXP0N_l3cIx-oD;GP7I\">radar_alt</variable><variable id=\"k@97CGpNF24/Ycln3)cU\">gpws_stage</variable></variables><comment x=\"1960.453125\" y=\"2950\" w=\"420\" h=\"120\">\n--- AIRBUS A330 / A350 SOUND FUNCTIONS ---\n</comment><comment x=\"2425.453125\" y=\"2950\" w=\"220\" h=\"120\">\n--- INITIALIZATION ---\n</comment><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"startHB\"><next><block type=\"device_clear_display\"><next><block type=\"function_call\"><mutation name=\"showPlaneIc