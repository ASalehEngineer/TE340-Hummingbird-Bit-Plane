ume\" precision=\"0\"></mutation><field name=\"SLIDER\">255</field></shadow></value><value name=\"endVolume\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"255\" label=\"EndVolume\" precision=\"0\"></mutation><field name=\"SLIDER\">255</field></shadow></value></block></value><next><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">60</field></shadow></value><next><block type=\"controls_if\"><value name=\"IF0\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">TRUE</field></shadow><block type=\"logic_compare\"><field name=\"OP\">EQ</field><value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"/T_{Kc%NjNduh^=nFp=;\">bank_angle</field></block></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value></block></value><statement name=\"DO0\"><block type=\"break_keyword\"></block></statement><next><block type=\"music_playable_play\"><field name=\"playbackMode\">music.PlaybackMode.UntilDone</field><value name=\"toPlay\"><shadow type=\"music_string_playable\"></shadow><block type=\"soundExpression_createSoundExpression\" inline=\"true\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" _expanded=\"0\" _input_init=\"true\"></mutation><field name=\"waveShape\">WaveShape.Sine</field><field name=\"effect\">SoundExpressionEffect.None</field><field name=\"interpolation\">InterpolationCurve.Linear</field><value name=\"startFrequency\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"5000\" label=\"StartFrequency\" precision=\"0\"></mutation><field name=\"SLIDER\">800</field></shadow></value><value name=\"endFrequency\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"5000\" label=\"EndFrequency\" precision=\"0\"></mutation><field name=\"SLIDER\">2200</field></shadow></value><value name=\"duration\"><shadow type=\"math_number_minmax\"><mutation min=\"1\" max=\"9999\" label=\"Duration\" precision=\"0\"></mutation><field name=\"SLIDER\">180</field></shadow></value><value name=\"startVolume\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"255\" label=\"StartVolume\" precision=\"0\"></mutation><field name=\"SLIDER\">255</field></shadow></value><value name=\"endVolume\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"255\" label=\"EndVolume\" precision=\"0\"></mutation><field name=\"SLIDER\">255</field></shadow></value></block></value><next><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">220</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></statement></block></statement></block></xml>","main.ts":"","README.md":"","main.py":"def on_logo_long_pressed():\n    global stobes\n    if stobes == 0:\n        stobes = 1\n    else:\n        stobes = 0\n        hummingbird.set_tri_led(TwoPort.ONE, 0, 0, 0)\n        hummingbird.set_tri_led(TwoPort.TWO, 0, 0, 0)\ninput.on_logo_event(TouchButtonEvent.LONG_PRESSED, on_logo_long_pressed)\n\ndef on_button_pressed_a():\n    global display\n    if display == 0:\n        display = 1\n    else:\n        display = 0\n        if stall == 0 and pull_up == 0 and bank_angle == 0:\n            show_plane_icon()\ninput.on_button_pressed(Button.A, on_button_pressed_a)\n\ndef show_plane_icon():\n    basic.show_leds(\"\"\"\n        . . # . .\n        . . # . .\n        # # # # #\n        . . # . .\n        . # # # .\n        \"\"\")\n\ndef get_altitude_feet():\n    global last_valid_alt\n    # Read HC-SR04 in cm from Hummingbird Sensor Port 1\n    raw_cm = hummingbird.get_sensor(SensorType.DISTANCE, ThreePort.ONE)\n    \n    # Filter out blind-zone glitches (<= 1 cm) and out-of-range spikes (> 300 cm)\n    if raw_cm <= 1 or raw_cm > 300:\n        return Math.round(last_valid_alt / 30)\n    \n    # Subtract landing gear mounting height (in cm) so ground level reads 0\n    alt_cm = raw_cm - GEAR_OFFSET\n    if alt_cm < 0:\n        alt_cm = 0\n        \n    # Ignore sudden impossible jumps (> 60 cm in one reading)\n    if Math.abs(alt_cm - last_valid_alt) > 60 and last_valid_alt != 0:\n        return Math.round(last_valid_alt / 30)\n        \n    last_valid_alt = alt_cm\n    # Divide cm by 30 and round to nearest whole foot\n    return Math.round(alt_cm / 30)\n\ndef play_callout_tone(pitch_hz: number):\n    music.play(music.create_sound_expression(WaveShape.SINE,\n            pitch_hz,\n            pitch_hz,\n            255,\n            255,\n            90,\n            SoundExpressionEffect.NONE,\n            InterpolationCurve.LINEAR),\n        music.PlaybackMode.UNTIL_DONE)\n\ndef play_retard_tone():\n    for index in range(2):\n        music.play(music.create_sound_expression(WaveShape.SQUARE,\n                1600,\n                1200,\n                255,\n                255,\n                110,\n                SoundExpressionEffect.NONE,\n                InterpolationCurve.LINEAR),\n            music.PlaybackMode.UNTIL_DONE)\n        basic.pause(40)\n\ndef play_stall():\n    for index in range(8):\n        if stall == 0:\n            break\n        music.play(music.create_sound_expression(WaveShape.SQUARE,\n                2800,\n                2800,\n                255,\n                255,\n                40,\n                SoundExpressionEffect.NONE,\n                InterpolationCurve.LINEAR),\n            music.PlaybackMode.UNTIL_DONE)\n        if stall == 0:\n            break\n        music.play(music.create_sound_expression(WaveShape.SQUARE,\n                1400,\n                1400,\n                255,\n                255,\n                40,\n                SoundExpressionEffect.NONE,\n                InterpolationCurve.LINEAR),\n            music.PlaybackMode.UNTIL_DONE)\n    basic.pause(150)\n\ndef play_pull_up():\n    for index in range(4):\n        if pull_up == 0:\n            break\n        music.play(music.create_sound_expression(WaveShape.SAWTOOTH,\n                600,\n                3200,\n                255,\n                255,\n                130,\n                SoundExpressionEffect.NONE,\n                InterpolationCurve.CURVE),\n            music.PlaybackMode.UNTIL_DONE)\n        basic.pause(40)\n\ndef play_bank_angle():\n    for index in range(2):\n        if bank_angle == 0:\n            break\n        music.play(music.create_sound_expression(WaveShape.SINE,\n                800,\n                2200,\n                255,\n                255,\n                180,\n                SoundExpressionEffect.NONE,\n                InterpolationCurve.LINEAR),\n            music.PlaybackMode.UNTIL_DONE)\n        basic.pause(60)\n        if bank_angle == 0:\n            break\n        music.play(music.create_sound_expression(WaveShape.SINE,\n                800,\n                2200,\n                255,\n                255,\n                180,\n                SoundExpressionEffect.NONE,\n                InterpolationCurve.LINEAR),\n            music.PlaybackMode.UNTIL_DONE)\n        basic.pause(220)\n\ndef on_gesture_logo_up():\n    global stall, bank_angle, pull_up\n    stall = 1\n    bank_angle = 0\n    pull_up = 0\ninput.on_gesture(Gesture.LOGO_UP, on_gesture_logo_up)\n\ndef on_gesture_logo_down():\n    global pull_up, stall, bank_angle\n    pull_up = 1\n    stall = 0\n    bank_angle = 0\ninput.on_gesture(Gesture.LOGO_DOWN, on_gesture_logo_down)\n\ndef on_gesture_tilt_left():\n    global bank_angle, stall, pull_up\n    bank_angle = 1\n    stall = 0\n    pull_up = 0\ninput.on_gesture(Gesture.TILT_LEFT, on_gesture_tilt_left)\n\ndef on_gesture_tilt_right():\n    global bank_angle, stall, pull_up\n    bank_angle = 1\n    stall = 0\n    pull_up = 0\ninput.on_gesture(Gesture.TILT_RIGHT, on_gesture_tilt_right)\n\ndef on_gesture_screen_up():\n    global bank_angle, stall, pull_up\n    bank_angle = 0\n    stall = 0\n    pull_up = 0\n    music.stop_all_sounds()\n    basic.clear_screen()\n    if display == 0:\n        show_plane_icon()\ninput.on_gesture(Gesture.SCREEN_UP, on_gesture_screen_up)\n\ndef on_button_pressed_b():\n    global landing\n    if landing == 0:\n        landing = 1\n    else:\n        landing = 0\ninput.on_button_pressed(Button.B, on_button_pressed_b)\n\ndef on_logo_pressed():\n    global nav\n    if nav == 0:\n        nav = 1\n    else:\n        nav = 0\ninput.on_logo_event(TouchButtonEvent.PRESSED, on_logo_pressed)\n\n# --- Initialization ---\nGEAR_OFFSET = 4\nlast_valid_alt = 0\nprev_alt_ft = 0\ncallout_text = \"\"\n\npull_up = 0\nstall = 0\ndisplay = 0\nbank_angle = 0\nnav = 0\nstobes = 0\nlanding = 0\n\nhummingbird.start_hummingbird()\nbasic.clear_screen()\nshow_plane_icon()\n\n# --- Background Loops ---\n\n# 1. Sound & Descent Callouts Loop\ndef on_forever_sounds():\n    global prev_alt_ft, callout_text\n    if stall == 1:\n        play_stall()\n    elif pull_up == 1:\n        play_pull_up()\n    elif bank_angle == 1:\n        play_bank_angle()\n    else:\n        current_ft = get_altitude_feet()\n        # Trigger callouts only when descending (current altitude < previous altitude)\n        if current_ft < prev_alt_ft:\n            if current_ft == 5:\n                callout_text = \"5\"\n                play_callout_tone(1200)\n            elif current_ft == 4:\n                callout_text = \"4\"\n                play_callout_tone(1150)\n            elif current_ft == 3:\n                callout_text = \"3\"\n                play_callout_tone(1100)\n            elif current_ft == 2:\n                callout_text = \"2\"\n                play_callout_tone(1050)\n            elif current_ft == 1:\n                callout_text = \"1\"\n                play_callout_tone(1000)\n            elif current_ft == 0:\n                callout_text = \"RETARD\"\n                play_retard_tone()\n        prev_alt_ft = current_ft\n        basic.pause(60)\nbasic.forever(on_forever_sounds)\n\n# 2. Display Loop (Warnings -> Callouts -> Button A Altimeter)\ndef on_forever_display():\n    global callout_text\n    if stall == 1:\n        basic.show_string(\"STALL\", 65)\n    elif pull_up == 1:\n        basic.show_string(\"PULL UP\", 65)\n    elif bank_angle == 1:\n        basic.show_string(\"BANK ANGLE\", 65)\n    elif callout_text != \"\":\n        msg = callout_text\n        callout_text = \"\"\n        basic.show_string(msg, 55)\n        if display == 0 and stall == 0 and pull_up == 0 and bank_angle == 0:\n            show_plane_icon()\n    elif display == 1:\n        basic.show_number(get_altitude_feet(), 60)\n        basic.pause(150)\n    else:\n        basic.pause(50)\nbasic.forever(on_forever_display)\n\n# 3. Strobe Lights Loop\ndef on_every_interval():\n    if stobes == 1:\n        hummingbird.set_tri_led(TwoPort.ONE, 100, 100, 100)\n        hummingbird.set_tri_led(TwoPort.TWO, 100, 100, 100)\n        basic.pause(50)\n        hummingbird.set_tri_led(TwoPort.ONE, 0, 0, 0)\n        hummingbird.set_tri_led(TwoPort.TWO, 0, 0, 0)\n        basic.pause(100)\n        hummingbird.set_tri_led(TwoPort.ONE, 100, 100, 100)\n        hummingbird.set_tri_led(TwoPort.TWO, 100, 100, 100)\n        basic.pause(50)\n        hummingbird.set_tri_led(TwoPort.ONE, 0, 0, 0)\n        hummingbird.set_tri_led(TwoPort.TWO, 0, 0, 0)\n        basic.pause(1000)\nloops.every_interval(100, on_every_interval)\n\n# 4. Nav & Landing Lights Loop\ndef on_every_interval2():\n    if nav == 0:\n        hummingbird.set_led(ThreePort.ONE, 0)\n        hummingbird.set_led(ThreePort.TWO, 0)\n    else:\n        hummingbird.set_led(ThreePort.ONE, 100)\n        hummingbird.set_led(ThreePort.TWO, 100)\n    if landing == 0:\n        hummingbird.set_led(ThreePort.THREE, 0)\n    else:\n        hummingbird.set_led(ThreePort.THREE, 100)\nloops.every_interval(100, on_every_interval2)\n","pxt.json":"{\n    \"name\": \"TE340 Hummingbird Plane\",\n    \"description\": \"\",\n    \"dependencies\": {\n       