ction_name\">playGpwsPullUp</field><comment pinned=\"false\" h=\"80\" w=\"160\">6. EGPWS \"PULL UP\" Whoop-Whoop Alert (Rapid descent near ground)</comment><statement name=\"STACK\"><block type=\"controls_repeat_ext\"><value name=\"TIMES\"><shadow type=\"math_whole_number\"><field name=\"NUM\">2</field></shadow></value><statement name=\"DO\"><block type=\"music_playable_play\"><field name=\"playbackMode\">music.PlaybackMode.UntilDone</field><value name=\"toPlay\"><shadow type=\"music_string_playable\"></shadow><block type=\"soundExpression_createSoundExpression\" inline=\"true\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" _expanded=\"0\" _input_init=\"true\"></mutation><field name=\"waveShape\">WaveShape.Sawtooth</field><field name=\"effect\">SoundExpressionEffect.None</field><field name=\"interpolation\">InterpolationCurve.Linear</field><value name=\"startFrequency\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"5000\" label=\"StartFrequency\" precision=\"0\"></mutation><field name=\"SLIDER\">600</field></shadow></value><value name=\"endFrequency\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"5000\" label=\"EndFrequency\" precision=\"0\"></mutation><field name=\"SLIDER\">1500</field></shadow></value><value name=\"duration\"><shadow type=\"math_number_minmax\"><mutation min=\"1\" max=\"9999\" label=\"Duration\" precision=\"0\"></mutation><field name=\"SLIDER\">160</field></shadow></value><value name=\"startVolume\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"255\" label=\"StartVolume\" precision=\"0\"></mutation><field name=\"SLIDER\">255</field></shadow></value><value name=\"endVolume\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"255\" label=\"EndVolume\" precision=\"0\"></mutation><field name=\"SLIDER\">255</field></shadow></value></block></value><next><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">40</field></shadow></value></block></next></block></statement></block></statement></block><block type=\"function_definition\" x=\"1659\" y=\"2950\"><mutation name=\"showPlaneIcon\" functionid=\"xUb$$|@Egh36_,8@XM[?\"></mutation><field name=\"function_name\">showPlaneIcon</field><statement name=\"STACK\"><block type=\"device_show_leds\"><field name=\"LEDS\">`\n        . . # . . \n        . . # . . \n        # # # # # \n        . . # . . \n        . # # # .\n        `</field></block></statement></block></xml>","main.ts":"/**\n * --- AIRBUS A330 / A350 SOUND FUNCTIONS ---\n */\n/**\n * --- INITIALIZATION ---\n */\n// Long Press Logo: Toggle Strobe Lights\ninput.onLogoEvent(TouchButtonEvent.LongPressed, function () {\n    if (stobes == 0) {\n        stobes = 1\n    } else {\n        stobes = 0\n        hummingbird.setTriLED(\n        TwoPort.One,\n        0,\n        0,\n        0\n        )\n        hummingbird.setTriLED(\n        TwoPort.Two,\n        0,\n        0,\n        0\n        )\n    }\n})\n// 1. Airbus Stall Warning (\"Cricket\" chirp + Master Warning CRC)\nfunction playAirbusStall () {\n    for (let index = 0; index < 3; index++) {\n        music.play(music.createSoundExpression(WaveShape.Square, 1400, 2800, 255, 255, 90, SoundExpressionEffect.None, InterpolationCurve.Linear), music.PlaybackMode.UntilDone)\n        basic.pause(40)\n        music.playTone(750, 90)\n        music.playTone(1500, 90)\n        basic.pause(50)\n    }\n}\n// 3. Airbus Autopilot Disconnect (\"Cavalry Charge\" warble)\nfunction playAutopilotDisconnect () {\n    for (let index = 0; index < 3; index++) {\n        music.playTone(840, 110)\n        music.playTone(1680, 110)\n        basic.pause(50)\n    }\n}\n// Button A: Toggle Radar Altimeter Display\ninput.onButtonPressed(Button.A, function () {\n    if (display == 0) {\n        display = 1\n    } else {\n        display = 0\n        showPlaneIcon()\n    }\n})\n// 5. GPWS \"MINIMUMS\" Double Chime\nfunction playGpwsMinimums () {\n    music.playTone(880, 110)\n    basic.pause(40)\n    music.playTone(1175, 160)\n}\n// Logo Up (Pitch Up): Stall Warning\ninput.onGesture(Gesture.LogoUp, function () {\n    stall = 1\n    if (stall == 1) {\n        playAirbusStall()\n    }\n})\n// Tilt Left: Bank Angle\ninput.onGesture(Gesture.TiltLeft, function () {\n    bank_angle = 1\n    if (bank_angle == 1) {\n        playAirbusBankAngle()\n    }\n})\n// Level Wings (Screen Up): Reset Warnings\ninput.onGesture(Gesture.ScreenUp, function () {\n    if (bank_angle == 1 || stall == 1) {\n        bank_angle = 0\n        stall = 0\n        music.stopAllSounds()\n        display = 0\n        showPlaneIcon()\n    }\n})\nfunction showPlaneIcon () {\n    basic.showLeds(`\n        . . # . .\n        . . # . .\n        # # # # #\n        . . # . .\n        . # # # .\n        `)\n}\n// 6. EGPWS \"PULL UP\" Whoop-Whoop Alert (Rapid descent near ground)\nfunction playGpwsPullUp () {\n    for (let index = 0; index < 2; index++) {\n        music.play(music.createSoundExpression(WaveShape.Sawtooth, 600, 1500, 255, 255, 160, SoundExpressionEffect.None, InterpolationCurve.Linear), music.PlaybackMode.UntilDone)\n        basic.pause(40)\n    }\n}\n// Button B: Toggle Landing Light\ninput.onButtonPressed(Button.B, function () {\n    if (landing == 0) {\n        landing = 1\n    } else {\n        landing = 0\n    }\n})\n// 2. Airbus Bank Angle / EGPWS Caution (Crisp Double-Tone Chime)\nfunction playAirbusBankAngle () {\n    for (let index = 0; index < 2; index++) {\n        music.playTone(750, 120)\n        basic.pause(30)\n        music.playTone(1000, 180)\n        basic.pause(150)\n    }\n}\n// --- GESTURE & BUTTON EVENTS ---\n// Shake: Autopilot Disconnect\ninput.onGesture(Gesture.Shake, function () {\n    playAutopilotDisconnect()\n    basic.showString(\"AP OFF\")\n    showPlaneIcon()\n})\n// Tilt Right: Bank Angle\ninput.onGesture(Gesture.TiltRight, function () {\n    bank_angle = 1\n    if (bank_angle == 1) {\n        playAirbusBankAngle()\n    }\n})\n// 4. GPWS \"RETARD\" Triple Beep (Flare / Touchdown callout)\nfunction playGpwsRetard () {\n    for (let index = 0; index < 3; index++) {\n        music.playTone(950, 75)\n        basic.pause(55)\n    }\n}\n// Touch Logo: Toggle Nav Lights\ninput.onLogoEvent(TouchButtonEvent.Pressed, function () {\n    if (nav == 0) {\n        nav = 1\n    } else {\n        nav = 0\n    }\n})\nlet gpws_stage = 0\nlet radar_alt = 0\nlet nav = 0\nlet landing = 0\nlet bank_angle = 0\nlet stall = 0\nlet display = 0\nlet stobes = 0\nhummingbird.startHummingbird()\nbasic.clearScreen()\nshowPlaneIcon()\n// --- BACKGROUND LOOPS ---\n// Strobe Light Double-Flash Loop\nloops.everyInterval(50, function () {\n    if (stobes == 1) {\n        hummingbird.setTriLED(\n        TwoPort.One,\n        100,\n        100,\n        100\n        )\n        hummingbird.setTriLED(\n        TwoPort.Two,\n        100,\n        100,\n        100\n        )\n        basic.pause(50)\n        hummingbird.setTriLED(\n        TwoPort.One,\n        0,\n        0,\n        0\n        )\n        hummingbird.setTriLED(\n        TwoPort.Two,\n        0,\n        0,\n        0\n        )\n        basic.pause(100)\n        hummingbird.setTriLED(\n        TwoPort.One,\n        100,\n        100,\n        100\n        )\n        hummingbird.setTriLED(\n        TwoPort.Two,\n        100,\n        100,\n        100\n        )\n        basic.pause(50)\n        hummingbird.setTriLED(\n        TwoPort.One,\n        0,\n        0,\n        0\n        )\n        hummingbird.setTriLED(\n        TwoPort.Two,\n        0,\n        0,\n        0\n        )\n        basic.pause(1000)\n    }\n})\n// Nav & Landing Lights Loop\nloops.everyInterval(100, function () {\n    if (nav == 0) {\n        hummingbird.setLED(ThreePort.One, 0)\n        hummingbird.setLED(ThreePort.Two, 0)\n    } else {\n        hummingbird.setLED(ThreePort.One, 100)\n        hummingbird.setLED(ThreePort.Two, 100)\n    }\n    if (landing == 0) {\n        hummingbird.setLED(ThreePort.Three, 0)\n    } else {\n        hummingbird.setLED(ThreePort.Three, 100)\n    }\n})\n// Bank Angle Text Display Loop\nloops.everyInterval(100, function () {\n    if (bank_angle == 1) {\n        basic.showString(\"Bank\")\n    }\n})\n// Radar Altimeter & GPWS Callout Loop (Distance Sensor Port 3)\nloops.everyInterval(150, function () {\n    if (Math.round(hummingbird.getSensor(SensorType.Distance, ThreePort.Three) / 30) > 8 && hummingbird.getSensor(SensorType.Dial, ThreePort.One) == 0) {\n        radar_alt = 0\n    } else {\n        radar_alt = Math.round(hummingbird.getSensor(SensorType.Distance, ThreePort.Three) / 30)\n    }\n    if (display == 1 && bank_angle == 0) {\n        basic.showNumber(radar_alt)\n    }\n    // Trigger GPWS callouts as the plane descends toward the ground\n    if (radar_alt >= 5) {\n        // High altitude: reset callouts for next approach\n        gpws_stage = 0\n    } else if (radar_alt == 4 && gpws_stage < 1) {\n        gpws_stage = 1\n        playGpwsMinimums()\n    } else if (radar_alt == 2 && gpws_stage < 2) {\n        gpws_stage = 2\n        if (landing == 1) {\n            // Landing light ON = normal flare \"RETARD\"\n            playGpwsRetard()\n        } else {\n            // Landing light OFF = unsafe terrain \"PULL UP\"\n            playGpwsPullUp()\n        }\n    }\n})\n","README.md":"","pxt.json":"{\n    \"name\": \"TE340 Hummingbird Plane\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"pxt-hummingbird-bit\": \"github:birdbraintechnologies/pxt-hummingbird-bit#v0.0.7\",\n        \"microphone\": \"*\",\n        \"audio-recording\": \"*\",\n        \"pxt-flexfx\": \"github:grandpabond/pxt-flexfx#v2.2.7\",\n        \"midi\": \"github:microsoft/pxt-midi#v2.2.0\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"targetVersions\": {\n        \"branch\": \"v1.2.13\",\n        \"tag\": \"v1.2.13\",\n    