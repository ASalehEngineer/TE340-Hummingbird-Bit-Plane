D(TwoPort.Two, 100, 100, 100)\n"]]},{"start1":4516,"length1":188,"diffs":[[1,"        hummingbird.setTriLED(TwoPort.One, 0, 0, 0)\n        hummingbird.setTriLED(TwoPort.Two, 0, 0, 0)\n"]]},{"start1":4655,"length1":37,"diffs":[[1,"\n// Nav & Landing Lights Loop\nloops.everyInterval(100, function () {\n"]]},{"start1":5089,"length1":251,"diffs":[[1,"\n// Radar Altimeter & GPWS Callout Loop (Distance Sensor Port 3)\nloops.everyInterval(150, function () {\n    if (Math.round(hummingbird.getSensor(SensorType.Distance, ThreePort.Three) / 30) > 8 && hummingbird.getSensor(SensorType.Dial, ThreePort.One) == 0) {\n        radar_alt = 0\n    } else {\n        radar_alt = Math.round(hummingbird.getSensor(SensorType.Distance, ThreePort.Three) / 30)\n    }\n\n    if (display == 1 && bank_angle == 0) {\n        basic.showNumber(radar_alt)\n    }\n\n    // Trigger GPWS callouts as the plane descends toward the ground\n    if (radar_alt >= 5) {\n        gpws_stage = 0 // High altitude: reset callouts for next approach\n    } else if (radar_alt == 4 && gpws_stage < 1) {\n        gpws_stage = 1\n        playGpwsMinimums()\n    } else if (radar_alt == 2 && gpws_stage < 2) {\n        gpws_stage = 2\n        if (landing == 1) {\n            playGpwsRetard() // Landing light ON = normal flare \"RETARD\"\n"]]},{"start1":6034,"length1":107,"diffs":[[1,"            playGpwsPullUp() // Landing light OFF = unsafe terrain \"PULL UP\"\n"]]},{"start1":6121,"length1":163,"diffs":[[1,""]]},{"start1":6130,"length1":38,"diffs":[[1,"\n// Bank Angle Text Display Loop\nloops.everyInterval(100, function () {\n"]]},{"start1":6268,"length1":1163,"diffs":[[1,""]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":732,"length1":35,"diffs":[[1,"    \"preferredEditor\": \"tsprj\"\n"]]}]}]},{"timestamp":1795497607567,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":1997,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><var