\n        basic.pause(150)\n"]]},{"start1":836,"length1":0,"diffs":[[1,"}\n\n// 3. Airbus Autopilot Disconnect (\"Cavalry Charge\" warble)\nfunction playAutopilotDisconnect() {\n    for (let i = 0; i < 3; i++) {\n        music.playTone(840, 110)\n        music.playTone(1680, 110)\n        basic.pause(50)\n    }\n}\n\n// 4. GPWS \"RETARD\" Triple Beep (Flare / Touchdown callout)\nfunction playGpwsRetard() {\n    for (let i = 0; i < 3; i++) {\n        music.playTone(950, 75)\n        basic.pause(55)\n    }\n}\n\n// 5. GPWS \"MINIMUMS\" Double Chime\nfunction playGpwsMinimums() {\n    music.playTone(880, 110)\n    basic.pause(40)\n    music.playTone(1175, 160)\n}\n\n// 6. EGPWS \"PULL UP\" Whoop-Whoop Alert (Rapid descent near ground)\nfunction playGpwsPullUp() {\n    for (let i = 0; i < 2; i++) {\n        music.play(music.createSoundExpression(\n            WaveShape.Sawtooth,\n            600,\n            1500,\n            255,\n            255,\n            160,\n            SoundExpressionEffect.None,\n            InterpolationCurve.Linear\n        ), music.PlaybackMode.UntilDone)\n        basic.pause(40)\n    }\n}\n\nfunction showPlaneIcon() {\n    basic.showLeds(`\n        . . # . .\n        . . # . .\n        # # # # #\n        . . # . .\n        . # # # .\n        `)\n}\n\n// --- GESTURE & BUTTON EVENTS ---\n\n// Shake: Autopilot Disconnect\ninput.onGesture(Gesture.Shake, function () {\n    playAutopilotDisconnect()\n    basic.showString(\"AP OFF\")\n    showPlaneIcon()\n"]]},{"start1":2200,"length1":0,"diffs":[[1,"\n// Logo Up (Pitch Up): Stall Warning\n"]]},{"start1":2298,"length1":0,"diffs":[[1,"    if (stall == 1) {\n        playAirbusStall()\n    }\n"]]},{"start1":2355,"length1":0,"diffs":[[1,"\n// Tilt Left: Bank Angle\n"]]},{"start1":2448,"length1":0,"diffs":[[1,"    if (bank_angle == 1) {\n        playAirbusBankAngle()\n    }\n"]]},{"start1":2514,"length1":48,"diffs":[[1,"\n// Tilt Right: Bank Angle\ninput.onGesture(Gesture.TiltRight, function () {\n 