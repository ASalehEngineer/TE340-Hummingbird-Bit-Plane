def show_plane_icon():\n    basic.show_leds(\"\"\"\n        . . # . .\n        . . # . .\n        # # # # #\n        . . # . .\n        . # # # .\n        \"\"\")\n\ndef play_stall():\n    for index in range(8):\n        if stall == 0:\n            break\n        music.play(music.create_sound_expression(WaveShape.SQUARE,\n                2800,\n                2800,\n                255,\n                255,\n                40,\n                SoundExpressionEffect.NONE,\n                InterpolationCurve.LINEAR),\n            music.PlaybackMode.UNTIL_DONE)\n        if stall == 0:\n            break\n        music.play(music.create_sound_expression(WaveShape.SQUARE,\n                1400,\n                1400,\n                255,\n                255,\n                40,\n                SoundExpressionEffect.NONE,\n                InterpolationCurve.LINEAR),\n            music.PlaybackMode.UNTIL_DONE)\n    basic.pause(150)\n\ndef play_pull_up():\n    for index in range(4):\n        if pull_up == 0:\n            break\n        music.play(music.create_sound_expression(WaveShape.SAWTOOTH,\n                600,\n                3200,\n                255,\n                255,\n                130,\n                SoundExpressionEffect.NONE,\n                InterpolationCurve.CURVE),\n            music.PlaybackMode.UNTIL_DONE)\n        basic.pause(40)\n\ndef play_bank_angle():\n    for index in range(2):\n        if bank_angle == 0:\n            break\n        music.play(music.create_sound_expression(WaveShape.SINE,\n                800,\n                2200,\n                255,\n                255,\n                180,\n                SoundExpressionEffect.NONE,\n                InterpolationCurve.LINEAR),\n            music.PlaybackMode.UNTIL_DONE)\n        basic.pause(60)\n        if bank_angle == 0:\n            break\n        music.play(music.create_sound_expression(WaveShape.SINE,\n                800,\n                2200,\n                255,\n                255,\n                180,\n                SoundExpressionEffect.NONE,\n                InterpolationCurve.LINEAR),\n            music.PlaybackMode.UNTIL_DONE)\n        basic.pause(220)\n\ndef on_gesture_logo_up():\n    global stall, bank_angle, pull_up\n    stall = 1\n    bank_angle = 0\n    pull_up = 0\ninput.on_gesture(Gesture.LOGO_UP, on_gesture_logo_up)\n\ndef on_gesture_logo_down():\n    global pull_up, stall, bank_angle\n    pull_up = 1\n    stall = 0\n    bank_angle = 0\ninput.on_gesture(Gesture.LOGO_DOWN, on_gesture_logo_down)\n\ndef on_gesture_tilt_left():\n    global bank_angle, stall, pull_up\n    bank_angle = 1\n    stall = 0\n    pull_up = 0\ninput.on_gesture(Gesture.TILT_LEFT, on_gesture_tilt_left)\n\ndef on_gesture_tilt_right():\n    global bank_angle, stall, pull_up\n    bank_angle = 1\n    stall = 0\n    pull_up = 0\ninput.on_gesture(Gesture.TILT_RIGHT, on_gesture_tilt_right)\n\ndef on_gesture_screen_up():\n    global bank_angle, stall, pull_up, display\n    bank_angle = 0\n    stall = 0\n    pull_up = 0\n    display = 0\n    music.stop_all_sounds()\n    basic.clear_screen()\n    show_plane_icon()\ninput.on_gesture(Gesture.SCREEN_UP, on_gesture_screen_up)\n\ndef on_button_pressed_b():\n    global landing\n    if landing == 0:\n        landing = 1\n    else:\n        landing = 0\ninput.on_button_pressed(Button.B, on_button_pressed_b)\n\ndef on_logo_pressed():\n    global nav\n    if nav == 0:\n        nav = 1\n    else:\n        nav = 0\ninput.on_logo_event(TouchButtonEvent.PRESSED, on_logo_pressed)\n\n# --- Initialization ---\npull_up = 0\nstall = 0\ndisplay = 0\nbank_angle = 0\nnav = 0\nstobes = 0\nlanding = 0\n\nhummingbird.start_hummingbird()\nbasic.clear_screen()\nshow_plane_icon()\n\n# --- Background Loops ---\n\n# 1. Sound Loop\ndef on_forever_sounds():\n    if stall == 1:\n        play_stall()\n    elif pull_up == 1:\n        play_pull_up()\n    elif bank_angle == 1:\n        play_bank_angle()\n    else:\n        basic.pause(50)\nbasic.forever(on_forever_sounds)\n\n# 2. Display Loop\ndef on_forever_display():\n    if stall == 1:\n        basic.show_string(\"STALL\", 65)\n    elif pull_up == 1:\n        basic.show_string(\"PULL UP\", 65)\n    elif bank_angle == 1:\n        basic.show_string(\"BANK ANGLE\", 65)\n    else:\n        basic.pause(50)\nbasic.forever(on_forever_display)\n\n# 3. Strobe Lights Loop\ndef on_every_interval():\n    if stobes == 1:\n        hummingbird.set_tri_led(TwoPort.ONE, 100, 100, 100)\n        hummingbird.set_tri_led(TwoPort.TWO, 100, 100, 100)\n        basic.pause(50)\n        hummingbird.set_tri_led(TwoPort.ONE, 0, 0, 0)\n        hummingbird.set_tri_led(TwoPort.TWO, 0, 0, 0)\n        basic.pause(100)\n        hummingbird.set_tri_led(TwoPort.ONE, 100, 100, 100)\n        hummingbird.set_tri_led(TwoPort.TWO, 100, 100, 100)\n        basic.pause(50)\n        hummingbird.set_tri_led(TwoPort.ONE, 0, 0, 0)\n        hummingbird.set_tri_led(TwoPort.TWO, 0, 0, 0)\n        basic.pause(1000)\nloops.every_interval(100, on_every_interval)\n\n# 4. Nav & Landing Lights Loop\ndef on_every_interval2():\n    if nav == 0:\n        hummingbird.set_led(ThreePort.ONE, 0)\n        hummingbird.set_led(ThreePort.TWO, 0)\n    else:\n        hummingbird.set_led(ThreePort.ONE, 100)\n        hummingbird.set_led(ThreePort.TWO, 100)\n    if landing == 0:\n        hummingbird.set_led(ThreePort.THREE, 0)\n    else:\n        hummingbird.set_led(ThreePort.THREE, 100)\nloops.every_interval(100, on_every_interval2)\n"}]},{"timestamp":1795488359111,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":21685,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"1p.O)E3m!YrULojY:9?$\">stobes</variable><variable id=\".m0{b(ha]XH((BD)_2HY\">display</variable><variable id=\"z{hhnzX+exj?8Tp{aNIg\">stall</variable><variable id=\"aldE6]9nmV:K]AXa~aO0\">bank_angle</variable><variable id=\"NV2+IXCsRH|exWey0CHC