       music.stop_all_sounds()\n                return\n            basic.pause(10)\n    # Two-syllable synthetic \"Pull - Up\" cadence\n    if pull_up == 1:\n        music.play(music.create_sound_expression(WaveShape.SAWTOOTH,\n                520,\n                560,\n                255,\n                220,\n                110,\n                SoundExpressionEffect.NONE,\n                InterpolationCurve.LINEAR),\n            music.PlaybackMode.IN_BACKGROUND)\n        for _ in range(13):\n            if pull_up != 1:\n                music.stop_all_sounds()\n                return\n            basic.pause(10)\n    if pull_up == 1:\n        music.play(music.create_sound_expression(WaveShape.SAWTOOTH,\n                680,\n                620,\n                255,\n                180,\n                140,\n                SoundExpressionEffect.NONE,\n                InterpolationCurve.LINEAR),\n            music.PlaybackMode.IN_BACKGROUND)\n        for _ in range(28):\n            if pull_up != 1:\n                music.stop_all_sounds()\n                return\n            basic.pause(10)\n\ndef on_button_pressed_a():\n    global display\n    if display == 0:\n        display = 1\n    else:\n        display = 0\n        basic.show_leds(\"\"\"\n            . . # . .\n            . . # . .\n            # # # # #\n            . . # . .\n            . # # # .\n            \"\"\")\ninput.on_button_pressed(Button.A, on_button_pressed_a)\n\ndef on_gesture_logo_up():\n    global stall, pull_up, bank_angle\n    if stall == 0:\n        music.stop_all_sounds()\n    stall = 1\n    pull_up = 0\n    bank_angle = 0\ninput.on_gesture(Gesture.LOGO_UP, on_gesture_logo_up)\n\ndef on_gesture_tilt_left():\n    global bank_angle, stall, pull_up\n    if bank_angle == 0:\n        music.stop_all_sounds()\n    bank_angle = 1\n    stall = 0\n    pull_up = 0\ninput.on_gesture(Gesture.TILT_LEFT, on_gesture_tilt_left)\n\ndef on_gesture_screen_up():\n    global bank_angle, stall, pull_up, display\n    bank_angle = 0\n    stall = 0\n    pull_up = 0\n    music.stop_all_sounds()\n    display = 0\n    basic.show_leds(\"\"\"\n        . . # . .\n        . . # . .\n        # # # # #\n        . . # . .\n        . # # # .\n        \"\"\")\ninput.on_gesture(Gesture.SCREEN_UP, on_gesture_screen_up)\n\ndef play_airbus_stall():\n    # Airbus A330 Stall: High-pitched \"Cricket\" chirp + 750 Hz Master Warning CRC\n    for index3 in range(2):\n        if stall != 1:\n            music.stop_all_sounds()\n            return\n        music.play(music.create_sound_expression(WaveShape.SQUARE,\n                2600,\n                2520,\n                255,\n                180,\n                45,\n                SoundExpressionEffect.NONE,\n                InterpolationCurve.LINEAR),\n            music.PlaybackMode.IN_BACKGROUND)\n        for _ in range(7):\n            if stall != 1:\n                music.stop_all_sounds()\n                return\n            basic.pause(10)\n    if stall == 1:\n        music.play(music.create_sound_expression(WaveShape.TRIANGLE,\n                750,\n                742,\n                255,\n                30,\n                170,\n                SoundExpressionEffect.NONE,\n                InterpolationCurve.LOGARITHMIC),\n            music.PlaybackMode.IN_BACKGROUND)\n        for _ in range(21):\n            if stall != 1:\n                music.stop_all_sounds()\n                return\n            basic.pause(10)\n\ndef on_button_pressed_b():\n    global landing\n    if landing == 0:\n        landing = 1\n    else:\n        landing = 0\ninput.on_button_pressed(Button.B, on_button_pressed_b)\n\ndef on_gesture_tilt_right():\n    global bank_angle, stall, pull_up\n    if bank_angle == 0:\n        music.stop_all_sounds()\n    bank_angle = 1\n    stall = 0\n    pull_up = 0\ninput.on_gesture(Gesture.TILT_RIGHT, on_gesture_tilt_right)\n\ndef on_gesture_logo_down():\n    global pull_up, stall, bank_angle\n    if pull_up == 0:\n        music.stop_all_sounds()\n    pull_up = 1\n    stall = 0\n    bank_angle = 0\ninput.on_gesture(Gesture.LOGO_DOWN, on_gesture_logo_down)\n\ndef on_logo_pressed():\n    global nav\n    if nav == 0:\n        nav = 1\n    else:\n        nav = 0\ninput.on_logo_event(TouchButtonEvent.PRESSED, on_logo_pressed)\n\ndisplay = 0\npull_up = 0\nstall = 0\nbank_angle = 0\nnav = 0\nstobes = 0\nlanding = 0\nhummingbird.start_hummingbird()\nmusic.set_volume(255)\nbasic.clear_screen()\nlanding = 0\nstobes = 0\nnav = 0\nbank_angle = 0\nstall = 0\npull_up = 0\ndisplay = 0\nbasic.show_leds(\"\"\"\n    . . # . .\n    . . # . .\n    # # # # #\n    . . # . .\n    . # # # .\n    \"\"\")\n\ndef on_every_interval():\n    if stall == 1:\n        play_airbus_stall()\n    elif pull_up == 1:\n        play_airbus_pull_up()\n    elif bank_angle == 1:\n        play_airbus_bank_angle()\nloops.every_interval(20, on_every_interval)\n\ndef on_every_interval2():\n    if display == 1:\n        if Math.round(hummingbird.get_sensor(SensorType.DISTANCE, ThreePort.THREE) / 30) > 8 and hummingbird.get_sensor(SensorType.DIAL, ThreePort.ONE) == 0:\n            basic.show_number(0)\n        else:\n            basic.show_number(Math.round(hummingbird.get_sensor(SensorType.DISTANCE, ThreePort.THREE) / 30))\nloops.every_interval(0, on_every_interval2)\n\ndef on_every_interval3():\n    if stobes == 1:\n        hummingbird.set_tri_led(TwoPort.ONE, 100, 100, 100)\n        hummingbird.set_tri_led(TwoPort.TWO, 100, 100, 100)\n        basic.pause(50)\n        hummingbird.set_tri_led(TwoPort.ONE, 0, 0, 0)\n        hummingbird.set_tri_led(TwoPort.TWO, 0, 0, 0)\n        basic.pause(100)\n        hummingbird.set_tri_led(TwoPort.ONE, 100, 100, 100)\n        hummingbird.set_tri_led(TwoPort.TWO, 100, 100, 100)\n        basic.pause(50)\n        hummingbird.set_tri_led(TwoPort.ONE, 0, 0, 0)\n        hummingbird.set_tri_led(TwoPort.TWO, 0, 0, 0)\n        basic.pause(1000)\nloops.every_interval(0, on_every_interval3)\n\ndef on_every_interval4():\n    if nav == 0:\n        hummingbird.set_led(ThreePort.ONE, 0)\n        hummingbird.set_led(ThreePort.TWO, 0)\n    else:\n        hummingbird.set_led(ThreePort.ONE, 100)\n        hummingbird.set_led(ThreePort.TWO, 100)\n    if landing == 0:\n        hummingbird.set_led(ThreePort.THREE, 0)\n    else:\n        hummingbird.set_led(ThreePort.THREE, 100)\nloops.every_interval(0, on_every_interval4)\n\ndef on_every_interval5():\n    if stall == 1:\n        basic.show_string(\"Stall\")\n    elif pull_up == 1:\n        basic.show_string(\"Pull\")\n    elif bank_angle == 1:\n        basic.show_string(\"Bank\")\nloops.every_interval(60, on_every_interval5)\n","pxt.json":"{\n    \"name\": \"11/23/26 TE340 Hummingbird Plane\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"pxt-hummingbird-bit\": \"github:birdbraintechnologies/pxt-hummingbird-bit#v0.0.7\",\n        \"microphone\": \"*\",\n        \"audio-recording\": \"*\",\n        \"pxt-flexfx\": \"github:grandpabond/pxt-flexfx#v2.2.7\",\n        \"midi\": \"github:microsoft/pxt-midi#v2.2.0\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"targetVersions\": {\n        \"branch\": \"v1.2.13\",\n        \"tag\": \"v1.2.13\",\n        \"commits\": \"https://github.com/Microsoft/pxt-microbit/commits/5d5b348757b15c6d00f5b7f560fd69592ca29424\",\n        \"target\": \"9.0.12\",\n        \"pxt\": \"4.4.7\"\n    },\n    \"preferredEditor\": \"pyprj\"\n}\n"}},{"timestamp":1795494503222,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"%/ZG,Bls0yg|ceIy0}]:\">bank_angle</variable><variable id=\"^g|T/yJk!QC*?Q#e2Z}.\">_2</variable><variable id=\"H(7I-PktWn}{/TnTzHeG\">stobes</variable><variable id=\"~pW7?L229RVE-nhBpb(E\">pull_up</variable><variable id=\"HXE)t0M;?b{fh;,Jd8b|\